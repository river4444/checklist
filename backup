
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Habit & Journal Tracker</title>
    <style>
        :root {
            --bg-color: #0a0a0a;
            --panel-bg: rgba(26, 26, 26, 0.9);
            --text-primary: #ffffff;
            --text-secondary: #888888;
            --box-border: #222;
            --today-border: #ffffff;
            --editing-border: #ff4b2b;
            --bar-track: #1a1a1a;
            --bar-fill: #ffffff;
            --color-meditate: #4a90e2;
            --color-yoga: #a370f7;
            --color-workout: #f1c40f; /* YELLOW */
            --color-walk: #2ecc71;
            --color-fail: #610000;
        }

        /* Password Lock Styles */
        #lock-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: var(--bg-color); z-index: 10000;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            transition: opacity 0.5s ease;
        }
        .lock-input {
            background: #111; border: 1px solid #333; color: white;
            padding: 15px; border-radius: 8px; text-align: center;
            font-size: 1.5rem; outline: none; width: 150px;
            font-family: inherit; letter-spacing: 5px;
        }
        .lock-input:focus { border-color: #666; }
        .hidden-app { display: none !important; }

        * { box-sizing: border-box; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
        body { 
            margin: 0; background-color: var(--bg-color); 
            color: var(--text-primary); font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif; 
            display: flex; flex-direction: column; overflow-x: hidden; min-height: 100vh; cursor: default;
            user-select: none;
        }

        .main-content { flex: 1; display: flex; flex-direction: column; align-items: center; width: 100%; }

        /* Sidebar Styles */
        .stats-panel {
            width: 260px; height: 100dvh; background: var(--panel-bg); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
            border-right: 1px solid rgba(255, 255, 255, 0.08); position: fixed; left: -260px; top: 0; z-index: 1001;
            transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1); padding: 60px 24px; display: flex; flex-direction: column; gap: 30px;
            cursor: pointer;
        }
        .stats-panel.open { left: 0; }
        .stats-toggle {
            position: absolute; right: -40px; top: 50%; transform: translateY(-50%);
            width: 40px; height: 60px; background: var(--panel-bg); backdrop-filter: blur(25px); 
            border: 1px solid rgba(255, 255, 255, 0.08); border-left: none; border-radius: 0 8px 8px 0;
            display: flex; align-items: center; justify-content: center; color: var(--text-secondary);
        }

        .journal-panel {
            width: 100%; max-width: 380px; height: 100dvh; background: var(--panel-bg); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
            border-left: 1px solid rgba(255, 255, 255, 0.08); position: fixed; right: -100%; top: 0; padding: 40px 24px; 
            transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; z-index: 1000; 
            box-shadow: -15px 0 35px rgba(0,0,0,0.6); user-select: text;
        }
        .journal-panel.open { right: 0; }

        .journal-header-container { display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; }
        .nav-btns { display: flex; gap: 5px; }
        .nav-btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; }

        .day-checkbox { aspect-ratio: 1; width: 100%; max-width: 40px; border: 1px solid var(--box-border); border-radius: 4px; cursor: pointer; position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; overflow: hidden; background: #111; margin: 0 auto; transition: border-color 0.3s; }
        .day-checkbox.is-today { border-color: var(--today-border); border-width: 1.5px; }
        .day-checkbox.is-editing { border-color: var(--editing-border) !important; border-width: 2px !important; box-shadow: 0 0 12px rgba(255, 75, 43, 0.3); z-index: 5; }

        .day-spacer { aspect-ratio: 1; width: 100%; max-width: 40px; }
        .day-header { font-size: 0.55rem; color: var(--text-secondary); text-align: center; padding-bottom: 4px; opacity: 0.5; font-weight: 700; }

        .zoom-controls { position: fixed; top: 20px; left: 20px; z-index: 1100; display: flex; gap: 10px; }
        .zoom-btn { background: #111; border: 1px solid #333; color: var(--text-secondary); padding: 6px 14px; cursor: pointer; border-radius: 6px; font-size: 0.7rem; text-transform: uppercase; }
        .zoom-btn.active { color: #fff; border-color: #666; background: #222; }

        .wrapper { width: 100%; max-width: 450px; padding: 80px 20px 40px 20px; text-align: center; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); transform-origin: top center; }
        @media (max-width: 480px) { .wrapper.x2 { transform: scale(1.3); margin-bottom: 30vh; } }
        @media (min-width: 481px) { .wrapper.x2 { transform: scale(2); margin-bottom: 120vh; } }

        .percentage-display { font-size: 4.5rem; font-weight: 200; margin: 0; line-height: 1; letter-spacing: -2px; }
        .progress-container { width: 100%; height: 2px; background: var(--bar-track); border-radius: 1px; margin: 2rem 0; overflow: hidden; }
        .progress-fill { height: 100%; width: 0%; background: var(--bar-fill); transition: width 1.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .current-date { margin-top: 1.5rem; font-size: 0.8rem; color: var(--text-secondary); padding-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.2em; }

        .agreements-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 1.5rem 0; padding: 1.5rem 10px; border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; }
        .agreement-item { font-size: 0.52rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.4; opacity: 0.6; }

        .meta-toggle { font-size: 0.55rem; color: var(--text-secondary); opacity: 0.4; letter-spacing: 0.3em; cursor: pointer; transition: 0.3s; margin-bottom: 2rem; display: inline-block; }
        .meta-toggle:hover { opacity: 1; color: #fff; }
        
        #meta-content { max-height: 0; overflow: hidden; transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s; opacity: 0; pointer-events: none; }
        #meta-content.visible { max-height: 250px; opacity: 1; pointer-events: auto; margin-bottom: 2rem; }

        .summary-box { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem; padding: 0 10px; }
        .summary-item { font-size: 0.55rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; background: rgba(255,255,255,0.03); padding: 4px 6px; border-radius: 4px; }
        .summary-item span { color: #fff; font-weight: 600; }

        .view-controls { display: inline-flex; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 3px; }
        .view-btn { background: transparent; border: none; color: var(--text-secondary); padding: 6px 14px; font-size: 0.65rem; border-radius: 6px; cursor: pointer; text-transform: uppercase; }
        .view-btn.active { background: rgba(255, 255, 255, 0.1); color: #fff; }

        .heatmap-wrapper { width: 95%; max-width: 850px; margin: 100px auto 50px auto; padding-top: 30px; border-top: 1px solid #111; text-align: center; }
        .heatmap-grid { display: grid; grid-template-columns: repeat(53, 1fr); grid-template-rows: repeat(7, 1fr); gap: 4px; width: 100%; }
        .h-dot { aspect-ratio: 1; border-radius: 1px; background: #111; cursor: pointer; transition: background 0.3s; }
        .l-0 { background: #111; }
        .l-1 { background: rgba(255,255,255,0.15); }
        .l-2 { background: rgba(255,255,255,0.35); }
        .l-3 { background: rgba(255,255,255,0.55); }
        .l-4 { background: rgba(255,255,255,0.8); }
        .l-5 { background: #fff; box-shadow: 0 0 10px rgba(255,255,255,0.5); }
        .l-fail { background: var(--color-fail); }

        .month-group { text-align: left; margin-bottom: 32px; }
        .calendar-container.view-current .month-group.past, .calendar-container.view-current .month-group.future { display: none; }
        .month-title { font-size: 0.7rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 12px; letter-spacing: 0.2em; font-weight: 600; opacity: 0.5; }
        .days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }

        .q { width: 100%; height: 100%; opacity: 0; transition: opacity 0.3s ease; }
        .q.active { opacity: 1; }
        .q-0 { background: var(--color-meditate); }
        .q-1 { background: var(--color-yoga); }
        .q-2 { background: var(--color-workout); }
        .q-3 { background: var(--color-walk); }
        .day-number { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 600; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.8); pointer-events: none; z-index: 2; }

        .wake-section { margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 15px; }
        .wake-input { background: transparent; border: none; color: #fff; font-size: 1.1rem; text-align: right; width: 120px; outline: none; font-family: inherit; }
        
        .habit-item { display: flex; align-items: center; margin-bottom: 18px; font-size: 1rem; cursor: pointer; color: #ccc; padding: 4px 0; }
        .habit-item input { display: none; }
        .custom-checkbox { width: 22px; height: 22px; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 6px; margin-right: 14px; position: relative; background: rgba(0, 0, 0, 0.3); flex-shrink: 0; }
        .habit-item input:checked + .custom-checkbox { background: #fff; border-color: #fff; }
        .habit-item input:checked + .custom-checkbox::after { content: ''; position: absolute; left: 7px; top: 3px; width: 5px; height: 10px; border: solid #000; border-width: 0 2px 2px 0; transform: rotate(45deg); }

        .w-choice-container { display: flex; gap: 20px; margin-top: 15px; opacity: 0.2; transition: 0.3s; }
        .w-choice-container:hover { opacity: 1; }
        .w-choice-container .habit-item { margin-bottom: 0; font-size: 0.75rem; }
        .w-choice-container .custom-checkbox { width: 18px; height: 18px; }
        .w-choice-container .habit-item input:checked + .custom-checkbox::after { left: 5px; top: 1px; width: 4px; height: 9px; }

        textarea { flex: 1; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255,255,255,0.05); border-left: none; border-right: none; color: #eee; padding: 20px 24px; resize: none; font-family: inherit; margin-top: 25px; line-height: 1.6; width: calc(100% + 48px); margin-left: -24px; outline: none; font-size: 16px; }
        .backup-btn { flex: 1; background: transparent; border: 1px solid rgba(255,255,255,0.1); color: var(--text-secondary); padding: 8px; font-size: 0.6rem; border-radius: 4px; cursor: pointer; text-transform: uppercase; }
    </style>
</head>
<body id="body-root">

<!-- Password Overlay -->
<div id="lock-screen">
    <input type="password" id="pass-input" class="lock-input" placeholder="•" autofocus oninput="checkPass(this.value)">
</div>

<!-- Main App Content (hidden by default) -->
<div id="app-container" class="hidden-app">
    <div class="stats-panel" id="stats-panel" onclick="toggleStats()">
        <div class="stats-toggle"><span id="stats-arrow">→</span></div>
        <div style="display:flex; flex-direction:column; gap:30px;">
            <div class="stat-card"><span style="font-size:0.6rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:0.1em;">Avg Wake Up</span><span id="stat-avg" style="font-size:1.4rem; font-weight:200;">--:--</span></div>
            <div class="stat-card"><span style="font-size:0.6rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:0.1em;">Last 7 Days</span><span id="stat-7day" style="font-size:1.4rem; font-weight:200;">--:--</span></div>
            <div class="stat-card"><span style="font-size:0.6rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:0.1em;">Early Bird Score</span><span id="stat-score" style="font-size:1.4rem; font-weight:200;">0%</span></div>
            <div class="stat-card"><span style="font-size:0.6rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:0.1em;">Personal Best</span><span id="stat-best" style="font-size:1.4rem; font-weight:200;">--:--</span></div>
        </div>
    </div>

    <div class="zoom-controls">
        <button class="zoom-btn" id="btn-1x" onclick="setZoom(1)">1x</button>
        <button class="zoom-btn active" id="btn-2x" onclick="setZoom(2)">2x</button>
    </div>

    <div class="main-content">
        <div class="wrapper" id="main-wrapper">
            <h1 class="percentage-display"><span id="percentage">0</span><span>%</span></h1>
            <div class="progress-container"><div class="progress-fill" id="progress-fill"></div></div>
            <div class="current-date" id="full-date">---</div>

            <div class="agreements-grid">
                <div class="agreement-item">I. Be impeccable with your word</div>
                <div class="agreement-item">II. Do not take anything personally</div>
                <div class="agreement-item">III. Do not make assumptions</div>
                <div class="agreement-item">IV. Always do your best</div>
            </div>

            <div class="meta-toggle" onclick="toggleMeta()">INFO</div>

            <div id="meta-content">
                <div class="summary-box">
                    <div class="summary-item">Med <span id="summ-0">0/0</span></div>
                    <div class="summary-item">Yoga <span id="summ-1">0/0</span></div>
                    <div class="summary-item">Work <span id="summ-2">0/0</span></div>
                    <div class="summary-item">Walk <span id="summ-3">0/0</span></div>
                    <div class="summary-item">NW <span id="summ-4">0/0</span></div>
                    <div class="summary-item" style="color:#ff4b2b">W <span id="summ-5">0/0</span></div>
                </div>
                <div class="view-controls">
                    <button class="view-btn active" id="view-current-btn" onclick="setViewMode('current')">Current Month</button>
                    <button class="view-btn" id="view-year-btn" onclick="setViewMode('year')">Full Year</button>
                </div>
            </div>
            
            <div id="calendar-root" class="calendar-container view-current"></div>
        </div>

        <div class="heatmap-wrapper">
            <div class="heatmap-grid" id="heatmap-grid"></div>
        </div>
    </div>

    <div class="journal-panel" id="journal-panel">
        <div class="journal-header-container">
            <div id="journal-date-title" style="font-size:1.1rem; font-weight:300;">Date</div>
            <div class="nav-btns"><button class="nav-btn" onclick="changeDay(-1)">←</button><button class="nav-btn" onclick="changeDay(1)">→</button></div>
        </div>
        <div class="wake-section"><span style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-secondary);">Wake Up</span><input type="text" id="wake-time" class="wake-input" placeholder="--:-- AM"></div>
        <div id="habit-checklist" style="display:flex; flex-direction:column; flex-grow:1;">
            <label class="habit-item"><input type="checkbox" data-habit="0"><span class="custom-checkbox"></span>Meditate</label>
            <label class="habit-item"><input type="checkbox" data-habit="1"><span class="custom-checkbox"></span>Yoga</label>
            <label class="habit-item"><input type="checkbox" data-habit="2"><span class="custom-checkbox"></span>Workout</label>
            <label class="habit-item"><input type="checkbox" data-habit="3"><span class="custom-checkbox"></span>Walk</label>
            <textarea id="journal-text" placeholder=""></textarea>
            
            <div class="w-choice-container">
                <label class="habit-item"><input type="checkbox" data-habit="4" id="cb-nw"><span class="custom-checkbox"></span>NW</label>
                <label class="habit-item"><input type="checkbox" data-habit="5" id="cb-w"><span class="custom-checkbox"></span>W</label>
            </div>

            <div style="margin-top:20px; display:flex; gap:10px;">
                <button class="backup-btn" onclick="saveJSON()">Save</button>
                <button class="backup-btn" onclick="document.getElementById('load-input').click()">Load</button>
                <input type="file" id="load-input" style="display:none" onchange="loadJSON(event)">
            </div>
        </div>
    </div>
</div>

<script>
    // PASSWORD LOGIC
    function checkPass(val) {
        if (val === "2") {
            document.getElementById('lock-screen').style.opacity = '0';
            setTimeout(() => {
                document.getElementById('lock-screen').style.display = 'none';
                document.getElementById('app-container').classList.remove('hidden-app');
            }, 500);
        }
    }

    let currentEditingKey = null, currentScale = 2;
    const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

    function getPerthTime() {
        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', { timeZone: 'Australia/Perth', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: false });
        const parts = formatter.formatToParts(now);
        const d = {}; parts.forEach(p => d[p.type] = p.value);
        return new Date(d.year, d.month - 1, d.day, d.hour, d.minute, d.second);
    }

    function toggleMeta() { document.getElementById('meta-content').classList.toggle('visible'); }
    
    function toggleStats() {
        const panel = document.getElementById('stats-panel');
        panel.classList.toggle('open');
        document.getElementById('stats-arrow').innerText = panel.classList.contains('open') ? "←" : "→";
        if (panel.classList.contains('open')) calculateWakeStats();
    }

    function setZoom(scale) {
        currentScale = scale;
        document.getElementById('btn-1x').classList.toggle('active', scale === 1);
        document.getElementById('btn-2x').classList.toggle('active', scale === 2);
        document.getElementById('main-wrapper').className = scale === 2 ? 'wrapper x2' : 'wrapper';
    }

    function setViewMode(mode) {
        document.getElementById('calendar-root').className = mode === 'current' ? "calendar-container view-current" : "calendar-container view-year";
        document.getElementById('view-current-btn').classList.toggle('active', mode === 'current');
        document.getElementById('view-year-btn').classList.toggle('active', mode === 'year');
    }

    function changeDay(offset) {
        if (!currentEditingKey) return;
        const parts = currentEditingKey.split('-');
        const date = new Date(parts[0], parts[1], parts[2]);
        date.setDate(date.getDate() + offset);
        openJournal(`${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`, months[date.getMonth()], date.getDate());
    }

    function renderHeatmap() {
        const grid = document.getElementById('heatmap-grid'); grid.innerHTML = '';
        const year = getPerthTime().getFullYear();
        for (let row = 0; row < 7; row++) {
            for (let col = 0; col < 53; col++) {
                const d = new Date(year, 0, 1); d.setDate(d.getDate() + (col * 7) + row);
                if (d.getFullYear() > year) break;
                const dot = document.createElement('div');
                const key = `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
                const data = JSON.parse(localStorage.getItem(key));
                let count = 0;
                let isFail = false;
                if (data && data.habits) {
                    count = data.habits.slice(0, 4).filter(h => h === true).length;
                    if (data.habits[4]) count++; 
                    if (data.habits[5]) isFail = true; 
                }
                dot.className = `h-dot ${isFail ? 'l-fail' : 'l-' + count}`;
                dot.onclick = () => openJournal(key, months[d.getMonth()], d.getDate());
                grid.appendChild(dot);
            }
        }
    }

    function openJournal(key, month, day) {
        if (currentEditingKey) { const p = document.getElementById(`day-${currentEditingKey}`); if (p) p.classList.remove('is-editing'); }
        currentEditingKey = key;
        const c = document.getElementById(`day-${key}`); if (c) c.classList.add('is-editing');
        const data = JSON.parse(localStorage.getItem(key)) || { text: "", habits: [0,0,0,0,0,0], wake: "" };
        const parts = key.split('-');
        const dObj = new Date(parts[0], parts[1], parts[2]);
        const dayName = dayNames[dObj.getDay()];
        document.getElementById('journal-date-title').innerText = `${dayName}, ${month} ${day}`;
        document.getElementById('journal-text').value = data.text || "";
        document.getElementById('wake-time').value = data.wake || "";
        document.querySelectorAll('#habit-checklist input').forEach((cb, i) => cb.checked = data.habits ? !!data.habits[i] : false);
        document.getElementById('journal-panel').classList.add('open');
    }

    function closeJournal() {
        if (currentEditingKey) { const el = document.getElementById(`day-${currentEditingKey}`); if (el) el.classList.remove('is-editing'); }
        document.getElementById('journal-panel').classList.remove('open');
        currentEditingKey = null;
    }

    function calculateWakeStats() {
        const now = getPerthTime(), y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
        let all = [], rec = [], early = 0;
        for (let i = 1; i <= d; i++) {
            const data = JSON.parse(localStorage.getItem(`${y}-${m}-${i}`));
            if (data && data.wake) {
                const match = data.wake.match(/(\d+):(\d+)/);
                if (match) {
                    const mins = parseInt(match[1]) * 60 + parseInt(match[2]);
                    all.push(mins); if (i > d - 7) rec.push(mins); if (mins <= 480) early++;
                }
            }
        }
        const toT = (ms) => { if (!ms.length) return "--:--"; const a = ms.reduce((a,b)=>a+b)/ms.length; return `${Math.floor(a/60)}:${Math.floor(a%60).toString().padStart(2,'0')} AM`; };
        document.getElementById('stat-avg').innerText = toT(all);
        document.getElementById('stat-7day').innerText = toT(rec);
        document.getElementById('stat-score').innerText = all.length ? Math.round((early/all.length)*100)+"%" : "0%";
        if (all.length) { document.getElementById('stat-best').innerText = `${Math.floor(Math.min(...all)/60)}:${(Math.min(...all)%60).toString().padStart(2,'0')} AM`; }
    }

    function formatWakeTime(v) {
        let c = v.replace(/[^0-9]/g, ''); if (!c) return "";
        let h, m; if (c.length <= 2) { h = parseInt(c); m = 0; } else if (c.length === 3) { h = parseInt(c[0]); m = parseInt(c.slice(1)); } else { h = parseInt(c.slice(0, 2)); m = parseInt(c.slice(2, 4)); }
        if (h > 12) h = 12; if (m > 59) m = 59; if (h === 0) h = 12;
        return `${h}:${m.toString().padStart(2, '0')} AM`;
    }

    function updateSummary() {
        const n = getPerthTime(), y = n.getFullYear(), m = n.getMonth(), d = n.getDate();
        let t = [0,0,0,0,0,0];
        for (let i = 1; i <= d; i++) {
            const data = JSON.parse(localStorage.getItem(`${y}-${m}-${i}`));
            if (data && data.habits) data.habits.forEach((c, idx) => { if (c) t[idx]++; });
        }
        t.forEach((c, i) => { 
            const el = document.getElementById(`summ-${i}`); 
            if (el) {
                if (i === 5) {
                    const pct = d > 0 ? Math.round((c / d) * 100) : 0;
                    el.innerText = `${c}/${d} (${pct}%)`;
                } else {
                    el.innerText = `${c}/${d}`; 
                }
            }
        });
        calculateWakeStats(); renderHeatmap();
    }

    function saveJSON() {
        const data = {}; for (let i = 0; i < localStorage.length; i++) { data[localStorage.key(i)] = localStorage.getItem(localStorage.key(i)); }
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' })); a.download = `tracker.json`; a.click();
    }

    function loadJSON(e) {
        const reader = new FileReader(); reader.onload = (ev) => { const d = JSON.parse(ev.target.result); localStorage.clear(); Object.keys(d).forEach(k => localStorage.setItem(k, d[k])); location.reload(); }; reader.readAsText(e.target.files[0]);
    }

    function init() {
        const now = getPerthTime();
        const start = new Date(now.getFullYear(), 0, 1), end = new Date(now.getFullYear() + 1, 0, 1);
        const percent = (((now - start) / (end - start)) * 100).toFixed(1);
        
        setZoom(2);

        document.getElementById('percentage').innerText = percent;
        document.getElementById('full-date').innerText = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'Australia/Perth' }).format(new Date());
        setTimeout(() => { document.getElementById('progress-fill').style.width = percent + '%'; }, 300);
        generateCalendar(now.getFullYear(), now.getMonth(), now.getDate());
        setupListeners(); updateSummary();
    }

    function generateCalendar(year, currentMonth, currentDate) {
        const root = document.getElementById('calendar-root');
        const dayHeaders = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
        months.forEach((name, mIdx) => {
            const group = document.createElement('div'); group.className = `month-group ${mIdx < currentMonth ? 'past' : mIdx > currentMonth ? 'future' : 'current'}`;
            const grid = document.createElement('div'); grid.className = 'days-grid';
            dayHeaders.forEach(day => {
                const h = document.createElement('div'); h.className = 'day-header'; h.innerText = day; grid.appendChild(h);
            });
            let firstDay = new Date(year, mIdx, 1).getDay();
            let offset = firstDay === 0 ? 6 : firstDay - 1;
            for (let i = 0; i < offset; i++) {
                const spacer = document.createElement('div'); spacer.className = 'day-spacer'; grid.appendChild(spacer);
            }
            const daysInMonth = new Date(year, mIdx + 1, 0).getDate();
            for (let d = 1; d <= daysInMonth; d++) {
                const key = `${year}-${mIdx}-${d}`;
                const box = document.createElement('div'); box.className = 'day-checkbox'; box.id = `day-${key}`;
                for (let i = 0; i < 4; i++) { const q = document.createElement('div'); q.className = `q q-${i}`; box.appendChild(q); }
                const num = document.createElement('div'); num.className = 'day-number'; num.innerText = d; box.appendChild(num);
                if (mIdx === currentMonth && d === currentDate) box.classList.add('is-today');
                updateBoxVisuals(box, key);
                box.onclick = (e) => { e.stopPropagation(); openJournal(key, name, d); };
                grid.appendChild(box);
            }
            const title = document.createElement('div'); title.className = 'month-title'; title.innerText = name;
            group.appendChild(title); group.appendChild(grid); root.appendChild(group);
        });
    }

    function setupListeners() {
        document.addEventListener('dblclick', (e) => {
            if (e.target.closest('.zoom-controls') || e.target.closest('.view-controls') || e.target.closest('.day-checkbox') || e.target.closest('.journal-panel') || e.target.closest('.stats-panel')) return;
            setZoom(currentScale === 1 ? 2 : 1);
        });

        document.getElementById('body-root').onclick = (e) => {
            if (e.target.closest('.journal-panel') || e.target.closest('.stats-panel') || e.target.closest('.day-checkbox') || e.target.closest('.zoom-controls') || e.target.closest('.view-controls') || e.target.closest('.meta-toggle') || e.target.closest('#lock-screen')) return;
            if (document.getElementById('stats-panel').classList.contains('open')) toggleStats();
            if (document.getElementById('journal-panel').classList.contains('open')) closeJournal();
            else { const n = getPerthTime(); openJournal(`${n.getFullYear()}-${n.getMonth()}-${n.getDate()}`, months[n.getMonth()], n.getDate()); }
        };

        const wake = document.getElementById('wake-time'), text = document.getElementById('journal-text'), habits = document.querySelectorAll('#habit-checklist input');
        const save = () => { if (!currentEditingKey) return; localStorage.setItem(currentEditingKey, JSON.stringify({ text: text.value, habits: Array.from(habits).map(c => c.checked), wake: wake.value })); updateBoxVisuals(document.getElementById(`day-${currentEditingKey}`), currentEditingKey); updateSummary(); };
        const nw = document.getElementById('cb-nw'), w = document.getElementById('cb-w');
        nw.onchange = () => { if (nw.checked) w.checked = false; save(); };
        w.onchange = () => { if (w.checked) nw.checked = false; save(); };
        wake.onblur = () => { wake.value = formatWakeTime(wake.value); save(); };
        text.oninput = save;
        habits.forEach(h => { if (h.id !== 'cb-nw' && h.id !== 'cb-w') h.onchange = save; });
    }

    function updateBoxVisuals(el, key) { if (!el) return; const d = JSON.parse(localStorage.getItem(key)); el.querySelectorAll('.q').forEach((q, i) => { if (d && d.habits && d.habits[i]) q.classList.add('active'); else q.classList.remove('active'); }); }
    window.onload = init;
</script>
</body>
</html>
